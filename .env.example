# Environment Variables — PulseGuard Uptime Monitor
# Copy this file to .env and customise before running docker compose.

# -------------------------
# Backend Configuration
# -------------------------

# SQLite database path (relative to /app inside the container).
# For Docker: use the mounted volume path.
DATABASE_URL=sqlite:///./data/monitor.db

# How often (in seconds) the scheduler runs a full URL check cycle.
CHECK_INTERVAL_SECONDS=60

# HTTP request timeout per URL ping (in seconds, supports decimals).
CHECK_TIMEOUT_SECONDS=5.0
